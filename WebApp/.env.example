# Copy this file to .env (which is gitignored) and fill in real values.
# Any option normally passed on the command line can be set here instead;
# see `node build/index.js --help` for the full list (PORT, SECURE, TYPE, MODE, LOGGING, ...).

# Shared-secret token required to use the signaling server. Leave unset/empty
# to run without authentication (the default).
AUTHTOKEN=
